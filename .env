# Copy this file to ".env" (same folder as docker-compose.yml) and fill in your own
# values, then run:  docker compose up -d --build email
#
# .env is git-ignored — keep your credentials to yourself and do not commit them.
#
# ---------------------------------------------------------------------------
# Gmail
# ---------------------------------------------------------------------------
# Gmail will NOT accept your normal account password. You must:
#   1. Turn on 2-Step Verification on the Google account, then
#   2. create a 16-character App Password  (Google Account → Security → App passwords)
#   3. put that App Password in SMTP_PASSWORD below (spaces may be removed)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=whoamiwhoamiwhoami59@gmail.com
SMTP_PASSWORD=lsbd-tyne-wkfp-rjny
SMTP_FROM=whoamiwhoamiwhoami59@gmail.com

# ---------------------------------------------------------------------------
# Other providers
# ---------------------------------------------------------------------------
# Outlook/Office365 : SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_TLS=true
# Implicit SSL (465): SMTP_PORT=465                 SMTP_TLS=false
#
# Leave every value blank to keep the local mailbox-only behaviour.

