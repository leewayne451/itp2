{
  "realm": "servicejourney",
  "displayName": "ServiceJourney",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notContainsUsername and notEmail and passwordHistory(3) and passwordBlacklist(servicejourney-blocklist.txt)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "otpPolicyInitialCounter": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "accessTokenLifespan": 300,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "mfa_required",
        "description": "Must use TOTP two-factor authentication (all staff roles)"
      }
    ]
  },
  "smtpServer": {
    "host": "email",
    "port": "1025",
    "from": "noreply@servicejourney.local",
    "fromDisplayName": "ServiceJourney",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "clients": [
    {
      "clientId": "console",
      "name": "ServiceJourney console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CONSOLE_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://localhost:8080/callback"
      ],
      "webOrigins": [
        "https://localhost:8080"
      ],
      "rootUrl": "https://localhost:8080",
      "baseUrl": "/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:8080/*",
        "backchannel.logout.url": "${CONSOLE_BACKCHANNEL_LOGOUT_URL:https://accessmanagement:8080/backchannel-logout}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "servicejourney-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "servicejourney-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "authentication methods (amr)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "service1",
      "name": "Personal Laptop",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_SERVICE1_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://localhost:8081/callback"
      ],
      "webOrigins": [
        "https://localhost:8081"
      ],
      "rootUrl": "https://localhost:8081",
      "baseUrl": "/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:8081/*",
        "backchannel.logout.url": "${SERVICE1_BACKCHANNEL_LOGOUT_URL:https://service1:8080/backchannel-logout}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "servicejourney-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "servicejourney-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "authentication methods (amr)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "service2",
      "name": "Account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_SERVICE2_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://localhost:8082/callback"
      ],
      "webOrigins": [
        "https://localhost:8082"
      ],
      "rootUrl": "https://localhost:8082",
      "baseUrl": "/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:8082/*",
        "backchannel.logout.url": "${SERVICE2_BACKCHANNEL_LOGOUT_URL:https://service2:8080/backchannel-logout}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "servicejourney-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "servicejourney-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "authentication methods (amr)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "servicejourney-backend",
      "name": "ServiceJourney backend (user sync + events)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_BACKEND_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-servicejourney-backend",
      "enabled": true,
      "serviceAccountClientId": "servicejourney-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups",
          "view-events"
        ]
      }
    }
  ],
  "browserFlow": "servicejourney browser",
  "authenticatorConfig": [
    {
      "alias": "is staff",
      "config": {
        "condUserRole": "mfa_required",
        "negate": "false"
      }
    },
    {
      "alias": "is not staff",
      "config": {
        "condUserRole": "mfa_required",
        "negate": "true"
      }
    },
    {
      "alias": "amr password",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "28800"
      }
    },
    {
      "alias": "amr otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "28800"
      }
    },
    {
      "alias": "amr otp opt-in",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "28800"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "servicejourney browser",
      "description": "SSO cookie, or password then TOTP (required for staff, used by employees who opted in)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "servicejourney forms"
        }
      ]
    },
    {
      "alias": "servicejourney forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "amr password"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "servicejourney staff otp"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "servicejourney opt-in otp"
        }
      ]
    },
    {
      "alias": "servicejourney staff otp",
      "description": "Staff (role mfa_required) must use TOTP; set up on first sign-in",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "is staff"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr otp"
        }
      ]
    },
    {
      "alias": "servicejourney opt-in otp",
      "description": "Employees who set up TOTP are asked for it",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "is not staff"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr otp opt-in"
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "staff",
      "path": "/staff",
      "realmRoles": [
        "mfa_required"
      ],
      "attributes": {
        "description": [
          "All staff roles (admin, requestor, hr, director, aa, it_admin, euss): TOTP required"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":2,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}