# TEMPLATE ONLY — never put real credentials in this file.
# This file is committed to the repo; ".env" is the one that is git-ignored.
#
# Copy it to ".env" (same folder as docker-compose.yml), fill in your own values,
# then recreate the mail service so it picks them up:
#
#     docker compose up -d --force-recreate email
#
# NOTE: environment variables are fixed when a container is created, so editing
# .env alone does nothing until the container is recreated.
#
# ---------------------------------------------------------------------------
# Gmail
# ---------------------------------------------------------------------------
# Gmail will NOT accept your normal account password. You must:
#   1. turn on 2-Step Verification on the Google account, then
#   2. create an App Password (Google Account → Security → App passwords)
#   3. paste it below. Google shows it grouped as "xxxx xxxx xxxx xxxx" —
#      spaces or hyphens between the groups are fine, they are stripped for you.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=your.address@gmail.com

# ---------------------------------------------------------------------------
# Other providers
# ---------------------------------------------------------------------------
# Outlook/Office365 : SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_TLS=true
# Implicit SSL (465): SMTP_PORT=465                 SMTP_TLS=false
#
# Leave every value blank to keep the local mailbox-only behaviour.

# ---------------------------------------------------------------------------
# Single sign-on (Keycloak) and two-factor authentication (TOTP)
# ---------------------------------------------------------------------------
# The Keycloak secrets (KEYCLOAK_DB_PASSWORD, KEYCLOAK_ADMIN_PASSWORD,
# KEYCLOAK_BACKEND_CLIENT_SECRET, OIDC_CONSOLE_SECRET, OIDC_SERVICE1_SECRET,
# OIDC_SERVICE2_SECRET) are generated for you:  python scripts/generate_secrets.py
#
# Roles that must set up an authenticator app (comma-separated). Others may opt in.
# MFA_REQUIRED_ROLES=admin,requestor,hr,director,aa,it_admin,euss
#
# MFA_ENC_KEY is only needed to migrate authenticator apps enrolled before Keycloak
# (CHANGE 001-003) into Keycloak. Keep the value you already have; new set-ups don't use it.
# MFA_ENC_KEY=
